{
  "name": "pr-diff-graph",
  "version": "0.0.0",
  "private": true,
  "description": "GitHub Action that builds an interactive report of a large PR's changed files and their import graph",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "pr-diff-graph": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc --noEmit && tsc --noEmit -p tsconfig.client.json && node scripts/build.mjs dist",
    "test": "npm run build:client && vitest run --project unit",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "format": "prettier --write .",
    "grammars": "node scripts/fetch-grammars.mjs",
    "test:perf": "npm run build:client && vitest run --project perf",
    "build:client": "node scripts/build.mjs client"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/picomatch": "^4.0.3",
    "cytoscape": "^3.34.4",
    "cytoscape-expand-collapse": "^4.1.1",
    "cytoscape-fcose": "^2.2.0",
    "diff2html": "^3.4.56",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "highlight.js": "^11.12.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.10",
    "tree-sitter-go": "0.25.0",
    "tree-sitter-javascript": "0.25.0",
    "tree-sitter-python": "0.25.0",
    "tree-sitter-typescript": "0.23.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@actions/artifact": "^6.3.1",
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "fflate": "^0.8.3",
    "jsonc-parser": "^3.3.1",
    "picomatch": "^4.0.7",
    "web-tree-sitter": "0.27.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  }
}
